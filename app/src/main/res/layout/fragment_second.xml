<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE28A">

    <!-- Imagen -->
    <ImageView
        android:id="@+id/imgPerrito"
        android:layout_width="430dp"
        android:layout_height="430dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Perrito"
        android:scaleType="fitCenter"
        android:src="@drawable/perrito_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.526"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Boton a LoginFragment -->
    <Button
        android:id="@+id/btnIniciarSesion"
        android:layout_width="270dp"
        android:layout_height="85dp"
        android:text="Iniciar Sesión"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#5A000B"
        android:backgroundTint="#75B3FF"
        android:layout_marginTop="5dp"
        app:cornerRadius="40dp"
        app:layout_constraintTop_toBottomOf="@id/imgPerrito"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Boton a RegistroFragment -->
    <Button
        android:id="@+id/btnRegistrarse"
        android:layout_width="270dp"
        android:layout_height="85dp"
        android:text="Registrarse"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#5A000B"
        android:backgroundTint="@android:color/transparent"
        android:layout_marginTop="15dp"
        app:cornerRadius="40dp"
        app:strokeColor="#5A000B"
        app:strokeWidth="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnIniciarSesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>