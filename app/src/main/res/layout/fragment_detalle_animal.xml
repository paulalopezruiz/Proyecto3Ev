<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE28A">

    <ImageView
        android:id="@+id/imgDetalleAnimal"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="#CCCCCC"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen del animal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/contenedorDetalle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="20dp"
        android:background="@drawable/fondo_detalle_animal"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="215dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombreDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="#5A000B"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUbicacionDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación"
                    android:textColor="#5A000B"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtFavorito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textColor="#5A000B"
                android:textSize="40sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="28dp">

            <TextView
                android:id="@+id/txtSexoDetalle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="Sexo"
                android:textColor="#5A000B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/fondo_dato_verde" />

            <TextView
                android:id="@+id/txtEdadDetalle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="Edad"
                android:textColor="#5A000B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginStart="22dp"
                android:background="@drawable/fondo_dato_azul" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtInformacionDetalle"
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:text="Información"
            android:textColor="#5A000B"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/fondo_info_detalle" />

        <Button
            android:id="@+id/btnAdoptar"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:text="Adoptar"
            android:textColor="#5A000B"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@android:color/transparent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            app:cornerRadius="35dp"
            app:strokeColor="#5A000B"
            app:strokeWidth="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>