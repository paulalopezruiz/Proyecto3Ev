<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE28A">

    <TextView
        android:id="@+id/txtEncontrado"
        android:layout_width="340dp"
        android:layout_height="215dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/fondo_caja_azul"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:text="He\nencontrado\nun animal"
        android:textColor="#5A000B"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnQuieroAdoptar"
        android:layout_width="340dp"
        android:layout_height="215dp"
        android:layout_marginStart="90dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/boton_borde"
        android:gravity="center"
        android:text="Quiero\nadoptar"
        android:textColor="#5A000B"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtEncontrado" />

</androidx.constraintlayout.widget.ConstraintLayout>