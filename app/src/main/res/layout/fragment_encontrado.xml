<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE28A">


    <TextView
        android:id="@+id/txtEncontrado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="84dp"
        android:text="He encontrado\n     un animal"
        android:textColor="#5A000B"
        android:textSize="44sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Contenedor azul  -->
    <LinearLayout
        android:id="@+id/contenedorEncontrado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="55dp"
        android:background="@drawable/fondo_encontrado_azul"
        app:layout_constraintTop_toBottomOf="@id/txtEncontrado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Spinner para elegir tipo -->
        <Spinner
            android:id="@+id/spinnerTipo"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:background="@drawable/fondo_input_azul"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <Spinner
            android:id="@+id/spinnerSexo"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_input_azul"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>

        <Spinner
            android:id="@+id/spinnerEstado"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_input_azul"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>

        <Spinner
            android:id="@+id/spinnerLocalizacion"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_input_azul"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>

        <!-- Botón -->
        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:text="Salvar"
            android:textColor="#5A000B"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#FFE28A"
            app:cornerRadius="30dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>