<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE28A">

    <ImageView
        android:id="@+id/imgAnimales"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/animales_logo"
        android:contentDescription="Logo animales"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adopta y Salva\nVidas"
        android:textColor="#5A000B"
        android:textSize="24sp"
        android:textStyle="bold"
        android:alpha="0"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgAnimales"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Listo para hacer un\nnuevo amigo?"
        android:textColor="#3A0000"
        android:textSize="16sp"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <View
        android:id="@+id/circulo"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginEnd="-55dp"
        android:layout_marginBottom="-40dp"
        android:background="@drawable/circulo_azul"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/flecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="42dp"
        android:gravity="center"
        android:text="→"
        android:textColor="#FFE28A"
        android:textSize="140sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/circulo"
        app:layout_constraintEnd_toEndOf="@id/circulo" />

</androidx.constraintlayout.widget.ConstraintLayout>