<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE28A">

    <ImageView
        android:id="@+id/imgDetalleAnimalMio"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="#CCCCCC"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen del animal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/contenedorDetalleAnimalMio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="20dp"
        android:background="@drawable/fondo_detalle_animal"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="215dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombreAnimalMio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="#5A000B"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUbicacionAnimalMio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación"
                    android:textColor="#5A000B"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtEditarAnimalMio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎"
                android:textColor="#5A000B"
                android:textSize="38sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorDatosAnimalMio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="38dp">

            <TextView
                android:id="@+id/txtSexoAnimalMio"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="Sexo"
                android:textColor="#5A000B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/fondo_dato_verde" />

            <TextView
                android:id="@+id/txtEdadAnimalMio"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="Edad"
                android:textColor="#5A000B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginStart="22dp"
                android:background="@drawable/fondo_dato_azul" />

            <TextView
                android:id="@+id/txtPesoAnimalMio"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="Peso"
                android:textColor="#5A000B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginStart="22dp"
                android:background="@drawable/fondo_dato_rosa" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtInformacionAnimalMio"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:text="Información"
            android:textColor="#5A000B"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/fondo_info_detalle" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>