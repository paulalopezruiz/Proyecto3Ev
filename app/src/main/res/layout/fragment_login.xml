<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE28A">

    <TextView
        android:id="@+id/txtBienvenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido a tu\nnueva familia"
        android:textColor="#5A000B"
        android:textSize="31sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/contenedorRegistro"
        android:layout_width="340dp"
        android:layout_height="315dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="@drawable/fondo_formulario"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/txtBienvenido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/edtNombreRegistro"
            android:layout_width="215dp"
            android:layout_height="55dp"
            android:hint="Nombre"
            android:textSize="17sp"
            android:textColor="#5A000B"
            android:textColorHint="#5A000B"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/fondo_input" />

        <EditText
            android:id="@+id/edtEmailRegistro"
            android:layout_width="215dp"
            android:layout_height="55dp"
            android:hint="Email"
            android:textSize="17sp"
            android:textColor="#5A000B"
            android:textColorHint="#5A000B"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/fondo_input"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/edtPasswordRegistro"
            android:layout_width="215dp"
            android:layout_height="55dp"
            android:hint="Contraseña"
            android:textSize="17sp"
            android:textColor="#5A000B"
            android:textColorHint="#5A000B"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/fondo_input"
            android:inputType="textPassword" />

    </LinearLayout>

    <Button
        android:id="@+id/btnEstoyListo"
        android:layout_width="210dp"
        android:layout_height="58dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@android:color/transparent"
        android:text="Estoy listo!!"
        android:textColor="#5A000B"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedorRegistro"
        app:strokeColor="#5A000B"
        app:strokeWidth="3dp" />

</androidx.constraintlayout.widget.ConstraintLayout>