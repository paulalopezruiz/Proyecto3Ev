<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE28A">

    <TextView
        android:id="@+id/txtHola"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola de\nnuevo !!"
        android:textColor="#5A000B"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/contenedorLogin"
        android:layout_width="360dp"
        android:layout_height="290dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/fondo_formulario_azul"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHola">

        <EditText
            android:id="@+id/edtNombreLogin"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:background="@drawable/fondo_input_azul"
            android:gravity="center"
            android:hint="Nombre"
            android:textColor="#5A000B"
            android:textColorHint="#5A000B"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtPasswordLogin"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/fondo_input_azul"
            android:gravity="center"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textColor="#5A000B"
            android:textColorHint="#5A000B"
            android:textSize="16sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="220dp"
        android:layout_height="58dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="40dp"
        android:backgroundTint="#75B3FF"
        android:text="Entrar"
        android:textColor="#5A000B"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedorLogin"
        app:strokeColor="#5A000B"
        app:strokeWidth="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout>