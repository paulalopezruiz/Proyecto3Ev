<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.animalesadopcion.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.animalesadopcion.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <!-- YA LO TENÍAS -->
        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />

        <!-- AÑADE ESTO -->
        <action
            android:id="@+id/action_SecondFragment_to_LoginFragment"
            app:destination="@id/LoginFragment" />

        <action
            android:id="@+id/action_SecondFragment_to_RegisterFragment"
            app:destination="@id/RegisterFragment" />
    </fragment>

    <!-- NUEVO: LOGIN -->
    <fragment
        android:id="@+id/LoginFragment"
        android:name="com.example.animalesadopcion.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" />

    <!-- NUEVO: REGISTER -->
    <fragment
        android:id="@+id/RegisterFragment"
        android:name="com.example.animalesadopcion.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register" />

</navigation>